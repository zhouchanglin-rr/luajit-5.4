+static void meta_cat_putint64(SBuf *sb, cTValue *o)
+{
+  GCcdata *cd = cdataV(o);
+  uint64_t u = *(uint64_t *)cdataptr(cd);
+  int isunsigned = cdata_isuint64(cd);
+  char buf[1+20], *p = buf+sizeof(buf);
