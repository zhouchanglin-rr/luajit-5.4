+    if (c == '.' || c == 'e' || c == 'E' || c == 'n' || c == 'i') return sb;
+  }
+  { char *w = lj_buf_more(sb, 2); *w++ = '.'; *w++ = '0'; sb->w = w; }
+  return sb;
